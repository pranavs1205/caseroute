# AnyAPI is the selected provider. Export these or put them in ignored .env.
# Only named settings are parsed; dotenv content is never executed.
ANYAPI_API_KEY=
# ANY_API_KEY is also accepted.
# Defaults are in llm_config.json. Override with an exact callable model ID:
# ANYAPI_MODEL=
# CASE_LLM_PROVIDER=anyapi
# CASE_LLM_MODEL=

# Optional local override, only when explicitly selected:
# CASE_LLM_PROVIDER=ollama
# CASE_LLM_MODEL=qwen2.5:0.5b
# OLLAMA_HOST=http://127.0.0.1:11434
